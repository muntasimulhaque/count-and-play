# Never commit Android release artifacts or signing credentials.
*.aab
*.apk
*.keystore
*.jks
signing-key-info.txt

# Android / Gradle build outputs
.gradle/
build/
local.properties
.kotlin/
captures/

# These archives can contain release artifacts or deployment copies.
*.zip

# Local editor and operating-system files.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# Local landing spot for the signed AAB pulled from the latest-build release.
aab/
# Retired screenshot staging folder; kept ignored so it can never be committed
# again. Uploads come from play-store/screenshots/.
store-shots/
__pycache__/
